// Original vcpkg WTL 10 headers, without OpenATL's build-local adapter.
// Every identifier below is intentionally from the public WTL/ATL surface.
// A RED here is a feature gap: do NOT delete the declaration to make it pass.
#include <atlbase.h>
#include <atlcom.h>
#include <atlwin.h>
#include "@OPENATL_WTL_DIRECT_ATLAPP@"
#include <atlframe.h>
#include <atlctrls.h>
#include <atldlgs.h>
#include <atlmisc.h>
#include <objbase.h>
#include <cstring>
#include <type_traits>

#ifndef OPENATL_REPOSITORY_HEADERS
#error OpenATL ATL source identity must be present
#endif
static_assert(OPENATL_REPOSITORY_HEADERS == 0x4F41544CUL,
              "Microsoft ATL or another ATL provider was selected");
static_assert(std::is_base_of_v<ATL::CComModule, WTL::CAppModule>,
              "Original WTL CAppModule must retain its CComModule inheritance");
static_assert(std::is_base_of_v<WTL::CAppModule, WTL::CServerAppModule>,
              "Original WTL COM server module must not be removed");
static_assert(std::is_class_v<WTL::CPrintDialogEx>,
              "Original WTL COM callback-based PrintDlgEx must be available");

// Exercise the original WTL PrintDlgEx COM callback and OpenATL's real
// IObjectWithSiteImpl without opening a printer UI or initializing COM.
class TestSite final : public IUnknown {
public:
    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID iid, void** out) noexcept override {
        if (!out) return E_POINTER;
        *out = nullptr;
        if (!::IsEqualIID(iid, IID_IUnknown)) return E_NOINTERFACE;
        *out = static_cast<IUnknown*>(this);
        AddRef();
        return S_OK;
    }
    ULONG STDMETHODCALLTYPE AddRef() noexcept override { return ++refs; }
    ULONG STDMETHODCALLTYPE Release() noexcept override { return --refs; }
    std::atomic<ULONG> refs{1};
};

bool OriginalPrintDialogCallbackNoCom()
{
    APTTYPE apartment = APTTYPE_CURRENT;
    APTTYPEQUALIFIER qualifier = APTTYPEQUALIFIER_NONE;
    if (::CoGetApartmentType(&apartment, &qualifier) != CO_E_NOTINITIALIZED)
        return false;
    WTL::CPrintDialogEx dialog;
    IPrintDialogCallback* callback = static_cast<IPrintDialogCallback*>(&dialog);
    void* output = reinterpret_cast<void*>(1);
    if (callback->QueryInterface(IID_IPrintDialogCallback, &output) != S_OK ||
        output != callback) return false;
    IObjectWithSite* site = nullptr;
    if (callback->QueryInterface(IID_IObjectWithSite,
            reinterpret_cast<void**>(&site)) != S_OK ||
        site != static_cast<IObjectWithSite*>(&dialog)) return false;
    if (site->GetSite(IID_IUnknown, nullptr) != E_POINTER) return false;
    output = reinterpret_cast<void*>(1);
    if (site->GetSite(IID_IUnknown, &output) != E_FAIL || output) return false;
    TestSite host;
    if (site->SetSite(&host) != S_OK || host.refs != 2) return false;
    output = nullptr;
    if (site->GetSite(IID_IUnknown, &output) != S_OK ||
        output != static_cast<IUnknown*>(&host) || host.refs != 3)
        return false;
    static_cast<IUnknown*>(output)->Release();
    output = reinterpret_cast<void*>(1);
    if (site->GetSite(IID_IClassFactory, &output) != E_NOINTERFACE || output)
        return false;
    if (site->SetSite(nullptr) != S_OK || host.refs != 1) return false;
    if (callback->InitDone() != S_FALSE || callback->SelectionChange() != S_FALSE)
        return false;
    if (callback->AddRef() != 1 || callback->Release() != 1) return false;
    return ::CoGetApartmentType(&apartment, &qualifier) == CO_E_NOTINITIALIZED;
}

bool RunServerMonitorTests();
bool RunRegPropertyTests();
bool RunOriginalHyperlinkRegistryTests();
bool RunLegacyObjectMapTests();

int main(int argc, char** argv)
{
    // The hyperlink test runs in its own process because Win32's
    // RegOverridePredefKey(HKCU) is process-wide. No real IE keys are edited.
    if (argc == 2 && std::strcmp(argv[1], "--hyperlink") == 0)
        return RunOriginalHyperlinkRegistryTests() ? 0 : 13;
    if (argc != 1) return 14;
    HINSTANCE image = ::GetModuleHandleW(nullptr);
    if (!image) return 1;
    {
        WTL::CAppModule app;
        HRESULT hr = app.Init(nullptr, image, nullptr);
        if (FAILED(hr) || app.m_dwMainThreadID != ::GetCurrentThreadId() ||
            app.GetModuleInstance() != image ||
            app.GetResourceInstance() != image) return 2;
        if (app.Init(nullptr, image, nullptr) != HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS))
            return 3;
        WTL::CMessageLoop messages;
        if (!app.AddMessageLoop(&messages)) return 4;
        if (app.GetMessageLoop() != &messages) return 5;
        if (!app.RemoveMessageLoop()) return 6;
        if (app.GetMessageLoop() != nullptr) return 7;
        APTTYPE apartment = APTTYPE_CURRENT;
        APTTYPEQUALIFIER qualifier = APTTYPEQUALIFIER_NONE;
        hr = ::CoGetApartmentType(&apartment, &qualifier);
        app.Term();
        if (hr != CO_E_NOTINITIALIZED) return 8;
    }
    // Real original WTL COM callback/site ownership, without showing UI.
    if (!OriginalPrintDialogCallbackNoCom()) return 10;
    // Original WTL shutdown monitor, using a retained worker thread handle
    // and a bounded join. The original detached StartMonitor remains an
    // independent unqualified admission gate.
    if (!RunServerMonitorTests()) return 11;
    // Original WTL10 registry properties, HKCU-only isolated owner.
    if (!RunRegPropertyTests()) return 12;
    // Real original ATL object-map registration, COM class activation,
    // wrong-thread rejection, reverse rollback and factory retirement.
    return RunLegacyObjectMapTests() ? 0 : 9;
}
