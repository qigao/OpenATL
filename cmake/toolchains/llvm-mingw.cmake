# Example: -DCMAKE_TOOLCHAIN_FILE=cmake/toolchains/llvm-mingw.cmake
#          -DOPENTL_LLVM_MINGW_BIN=/path/to/bin
#          -DOPENTL_TARGET_ARCH=x86_64 or aarch64
set(CMAKE_SYSTEM_NAME Windows)
if(NOT DEFINED OPENTL_TARGET_ARCH)
  message(FATAL_ERROR "Specify OPENTL_TARGET_ARCH=x86_64 or aarch64")
endif()
if(NOT OPENTL_TARGET_ARCH STREQUAL "x86_64" AND
   NOT OPENTL_TARGET_ARCH STREQUAL "aarch64")
  message(FATAL_ERROR "Unsupported OPENTL_TARGET_ARCH")
endif()
if(NOT DEFINED OPENTL_LLVM_MINGW_BIN)
  message(FATAL_ERROR "Specify OPENTL_LLVM_MINGW_BIN with pinned compiler directory")
endif()
set(CMAKE_SYSTEM_PROCESSOR "${OPENTL_TARGET_ARCH}")
set(CMAKE_C_COMPILER "${OPENTL_LLVM_MINGW_BIN}/${OPENTL_TARGET_ARCH}-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${OPENTL_LLVM_MINGW_BIN}/${OPENTL_TARGET_ARCH}-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${OPENTL_LLVM_MINGW_BIN}/${OPENTL_TARGET_ARCH}-w64-mingw32-windres")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
