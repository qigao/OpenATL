# Bridge the selected Windows SDK Ribbon declarations missing from mingw-w64.
# These build-local SDK headers are not ATL/MFC and are not redistributed.
function(openatl_use_ribbon_sdk target)
  if(NOT CMAKE_HOST_WIN32 OR NOT CMAKE_RC_STANDARD_INCLUDE_DIRECTORIES)
    message(FATAL_ERROR "MinGW Ribbon qualification requires the Windows SDK selected by llvm-i686")
  endif()
  list(GET CMAKE_RC_STANDARD_INCLUDE_DIRECTORIES 0 sdk)
  set(output "${CMAKE_CURRENT_BINARY_DIR}/ribbon-sdk")
  file(MAKE_DIRECTORY "${output}")
  foreach(header IN ITEMS UIRibbon.h UIRibbonKeyDef.h UIRibbonPropertyHelpers.h)
    if(NOT EXISTS "${sdk}/${header}")
      message(FATAL_ERROR "Missing selected Windows SDK Ribbon header: ${sdk}/${header}")
    endif()
    file(READ "${sdk}/${header}" text)
    if(header STREQUAL "UIRibbonPropertyHelpers.h")
      set(call "return valid ? PropVariantToUInt32(propvarIn, pulVal) : E_INVALIDARG;")
      string(FIND "${text}" "${call}" found)
      if(found EQUAL -1)
        message(FATAL_ERROR "Windows SDK UIPropertyToUInt32 declaration changed")
      endif()
      string(REPLACE "${call}"
        "if(!valid) return E_INVALIDARG;\n    if(!pulVal) return E_POINTER;\n    ULONG value = 0;\n    HRESULT hr = PropVariantToUInt32(propvarIn, &value);\n    if(SUCCEEDED(hr)) *pulVal = value;\n    return hr;" text "${text}")
    endif()
    # mingw-w64's versions assign to const inputs or redeclare a C-linkage
    # function from an extern C++ block. Restore the original macro meanings
    # after these SDK declarations, without changing any public function.
    file(WRITE "${output}/${header}"
      "#pragma push_macro(\"C_ASSERT\")\n#pragma push_macro(\"UNREFERENCED_PARAMETER\")\n#undef C_ASSERT\n#undef UNREFERENCED_PARAMETER\n#define C_ASSERT(e) static_assert(e, #e)\n#define UNREFERENCED_PARAMETER(p) static_cast<void>(p)\n${text}\n#pragma pop_macro(\"UNREFERENCED_PARAMETER\")\n#pragma pop_macro(\"C_ASSERT\")\n")
  endforeach()
  file(READ "${sdk}/UIRibbon.h" ribbon)
  string(REGEX MATCHALL "MIDL_INTERFACE\\(\"[0-9a-fA-F-]+\"\\)[ \t\r\n]+[A-Za-z_0-9]+[ \t\r\n]*:[ \t\r\n]*public" interfaces "${ribbon}")
  set(uuids "")
  set(definitions "")
  foreach(entry IN LISTS interfaces)
    string(REGEX MATCH "MIDL_INTERFACE\\(\"([0-9a-fA-F-]+)\"\\)[ \t\r\n]+([A-Za-z_0-9]+)" ignored "${entry}")
    set(name "${CMAKE_MATCH_2}")
    set(guid "${CMAKE_MATCH_1}")
    _openatl_ribbon_guid("${name}" "${guid}" "IID_${name}")
  endforeach()
  foreach(name IN ITEMS UIRibbonFramework UIRibbonImageFromBitmapFactory)
    string(REGEX MATCH "DECLSPEC_UUID\\(\"([0-9a-fA-F-]+)\"\\)[ \t\r\n]+${name};" ignored "${ribbon}")
    if(NOT CMAKE_MATCH_1)
      message(FATAL_ERROR "Missing Ribbon class UUID: ${name}")
    endif()
    _openatl_ribbon_guid("${name}" "${CMAKE_MATCH_1}" "CLSID_${name}")
  endforeach()
  if(NOT interfaces)
    message(FATAL_ERROR "No Ribbon interfaces in selected Windows SDK")
  endif()
  # SDK MIDL headers do not carry MinGW's __uuidof emulation specializations.
  file(APPEND "${output}/UIRibbon.h"
    "\n#if defined(__cplusplus) && !defined(OPENATL_RIBBON_UUIDS)\n#define OPENATL_RIBBON_UUIDS\n#ifdef __CRT_UUID_DECL\n${uuids}#endif\n${definitions}#endif\n")
  target_include_directories(${target} INTERFACE "${output}")
  target_link_libraries(${target} INTERFACE propsys)
endfunction()

function(_openatl_ribbon_guid name guid symbol)
  string(REPLACE "-" ";" fields "${guid}")
  list(GET fields 0 first)
  list(GET fields 1 second)
  list(GET fields 2 third)
  list(GET fields 3 fourth)
  list(GET fields 4 fifth)
  set(tail "${fourth}${fifth}")
  set(bytes "")
  foreach(index RANGE 0 7)
    math(EXPR offset "${index} * 2")
    string(SUBSTRING "${tail}" ${offset} 2 byte)
    string(APPEND bytes "0x${byte},")
  endforeach()
  set(uuids "${uuids}__CRT_UUID_DECL(${name},0x${first},0x${second},0x${third},${bytes})\n")
  # Drop the final comma from the macro arguments, retain it in C++ lists.
  string(REPLACE ",)" ")" uuids "${uuids}")
  set(uuids "${uuids}" PARENT_SCOPE)
  set(definitions "${definitions}extern \"C\" inline const IID ${symbol} = {0x${first},0x${second},0x${third},{${bytes}}};\n" PARENT_SCOPE)
endfunction()
