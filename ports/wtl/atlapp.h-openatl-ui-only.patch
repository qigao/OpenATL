+		if(pMap == NULL)
+			return E_OUTOFMEMORY;
+
+		m_dwMainThreadID = ::GetCurrentThreadId();
+		m_pMsgLoopMap = pMap;
+		m_pSettingChangeNotify = NULL;
+		ATL::_AtlBaseModule.m_hInst = hInstance;
+		ATL::_AtlBaseModule.m_hInstResource = hInstance;
+		return S_OK;
+	}
+
+	void Term()
+	{
+		if(m_pMsgLoopMap != NULL)
