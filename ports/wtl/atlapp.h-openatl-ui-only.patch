+	// OpenATL UI-only: real Win32 module lifecycle, no COM object map.
+	HRESULT Init(HINSTANCE hInstance)
+	{
+		if(hInstance == NULL)
+			return E_INVALIDARG;
+		if(m_pMsgLoopMap != NULL)
+			return HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS);
+
