# OpenATL local build: copy this file to .env and adjust paths for this host.
# Praktor loads .env through build.yml; direct CMake commands do not load it.
# Values are literal: use absolute, forward-slash paths, without quotes,
# $VAR, ${VAR}, or ~. Put CMake, Ninja and Praktor on the process PATH.

# Windows MSVC profiles only: Visual Studio developer environment and SDK tools.
# Set the path for your installed Visual Studio edition/version.
VSDEVCMD_BAT=C:/Program Files/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat

# LLVM-MinGW profiles only: the bin folder containing the target-prefixed drivers.
# On Linux/macOS, replace this with the host's LLVM-MinGW compiler bin folder.
OPENATL_LLVM_MINGW_BIN=C:/tools/llvm-mingw/bin

# Optional msvc-salts profile only: a matching Release Salts SDK using /MD.
# Keep this commented to retain an existing SALTS_ROOT in the parent environment.
# SALTS_ROOT=C:/path/to/salts/release

# Parallelism for cmake --build; adjust to the host's available memory.
CMAKE_BUILD_PARALLEL_LEVEL=2
